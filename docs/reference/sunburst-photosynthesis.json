  "version": 1,
  "kind": "sunburst",
  "title": "Photosynthesis",
  "description": "The same revision notes as the photosynthesis mind map, drawn as a sunburst.",
  "centre": "Photosynthesis",
  "nodes": [
    {"text": "Needs", "children": [
      {"text": "Light"}, {"text": "Water"}, {"text": "CO₂"}, {"text": "Chlorophyll"}
