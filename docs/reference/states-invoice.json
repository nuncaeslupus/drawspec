  "title": "What can happen to an invoice",
  "initial": "draft",
  "final": ["paid", "void", "written_off"],
  "states": [
    {"id": "draft", "text": "Draft"},
    {"id": "awaiting", "text": "Awaiting payment"},
    {"id": "overdue", "text": "Overdue"},
    {"id": "paid", "text": "Paid"},
    {"id": "void", "text": "Void"},
    {"id": "written_off", "text": "Written off", "role": "emphasis"}
  ],
  "groups": [
