  "$defs": {
    "axes": {
      "type": "object",
      "properties": {
        "horizontal": {
          "$ref": "#/$defs/axis"
        },
        "vertical": {
          "$ref": "#/$defs/axis"
        }
      },
      "required": [
        "horizontal",
        "vertical"
      ],
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Required: an unlabelled axis cannot be read."
        },
        "unit": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "categories": {
          "type": "array",
          "description": "Names for the positions 1, 2, 3 … along this axis, instead of numbers. What a bar chart's horizontal axis usually is: the quarters, the service models, the teams.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The words themselves. May carry inline spans — `code` for the monospace role and **bold** for emphasis — because those are semantic, not typographic."
        },
        "column": {
          "type": "integer",
          "description": "Which column this cell starts in, counting from zero."
        },
        "row": {
          "type": "integer",
          "description": "Which row it starts in, from zero."
        },
        "across": {
          "type": "integer",
          "description": "How many columns it covers. Default 1."
        },
        "down": {
          "type": "integer",
          "description": "How many rows it covers. Default 1."
        },
        "group": {
          "type": "string",
          "description": "Which group this cell belongs to. Cells sharing a group are filled alike; the theme decides how. Naming the fill itself is not an author's decision."
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
            "group"
          ]
        }
      },
      "required": [
        "text",
        "column",
        "row"
      ],
      "additionalProperties": false
    },
    "curve": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Drawn where the curve ends. Omit it when there is only one curve and the axes already say what it is."
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waypoint"
          },
          "minItems": 2
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
            "group"
          ]
        }
      },
      "required": [
        "waypoints"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "description": "The id of the source node."
        },
        "to": {
          "type": "string",
          "description": "The id of the target node."
        },
        "label": {
          "type": "string",
          "description": "A short label placed along the edge."
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'flow'.",
          "enum": [
            "flow",
            "link",
            "exchange",
            "weak",
            "owns",
            "strong"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "The words themselves. May carry inline spans — `code` for the monospace role and **bold** for emphasis — because those are semantic, not typographic."
        },
        "members": {
          "type": "array",
          "description": "The ids of the nodes this group contains.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "members"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Optional; generated from position when absent."
        },
        "text": {
          "type": "string",
          "description": "The words themselves. May carry inline spans — `code` for the monospace role and **bold** for emphasis — because those are semantic, not typographic."
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
            "group"
          ]
        },
        "note": {
          "type": "string"
        },
        "at": {
          "type": "number",
          "description": "For `timeline`: when this happened, so the gaps mean something. Give it to every entry or to none."
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The words themselves. May carry inline spans — `code` for the monospace role and **bold** for emphasis — because those are semantic, not typographic."
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
            "group"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the document."
        },
        "text": {
          "type": "string",
          "description": "The words themselves. May carry inline spans — `code` for the monospace role and **bold** for emphasis — because those are semantic, not typographic."
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
            "group"
          ]
        },
        "note": {
          "type": "string",
          "description": "A short aside attached to this node."
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The words themselves. May carry inline spans — `code` for the monospace role and **bold** for emphasis — because those are semantic, not typographic."
        },
        "across": {
          "type": "number",
          "description": "Where this sits on the horizontal axis. Data, not a coordinate."
        },
        "up": {
          "type": "number",
          "description": "Where this sits on the vertical axis. Data, not a coordinate."
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
            "group"
          ]
        }
      },
      "required": [
        "text",
        "across",
        "up"
      ],
      "additionalProperties": false
    },
    "ring": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The words themselves. May carry inline spans — `code` for the monospace role and **bold** for emphasis — because those are semantic, not typographic."
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
            "group"
          ]
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "description": "The values to plot, as [x, y] pairs. Data, not coordinates.",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
            "group"
          ]
        },
        "mark": {
          "type": "string",
          "description": "How this series is drawn: a line, bars, or a filled area. Default 'line'.",
          "enum": [
            "line",
            "bar",
            "area"
          ]
        },
        "stack": {
          "type": "string",
          "description": "Series sharing a stack name are piled on each other rather than drawn side by side. Bars and areas only."
        }
      },
      "required": [
        "name",
        "data"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The words themselves. May carry inline spans — `code` for the monospace role and **bold** for emphasis — because those are semantic, not typographic."
        },
        "role": {
          "type": "string",
          "description": "The semantic role, which the theme resolves to an appearance. Defaults to 'step'.",
          "enum": [
            "start",
            "step",
            "decision",
            "terminal",
            "emphasis",
            "note",
